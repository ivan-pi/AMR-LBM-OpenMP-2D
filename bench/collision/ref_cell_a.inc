        C0 = C_(+0,+0)
        eC2 = ( C_(+1,+0) - C_(-1,+0) )*cC
        eC3 = ( C_(+0,+1) - C_(+0,-1) )*cC
        eC6 = ( C_(+1,+1) - C_(-1,-1) )*cC
        eC7 = ( C_(-1,+1) - C_(+1,-1) )*cC
        C3  = 3._wp*C0
        eM2 = ( 5._wp*C_(+1,+0) - C_(-1,+0) - C3 - C_(+2,+0) )*cM
        eM4 = ( 5._wp*C_(-1,+0) - C_(+1,+0) - C3 - C_(-2,+0) )*cM
        eM3 = ( 5._wp*C_(+0,+1) - C_(+0,-1) - C3 - C_(+0,+2) )*cM
        eM5 = ( 5._wp*C_(+0,-1) - C_(+0,+1) - C3 - C_(+0,-2) )*cM
        eM6 = ( 5._wp*C_(+1,+1) - C_(-1,-1) - C3 - C_(+2,+2) )*cM
        eM8 = ( 5._wp*C_(-1,-1) - C_(+1,+1) - C3 - C_(-2,-2) )*cM
        eM7 = ( 5._wp*C_(-1,+1) - C_(+1,-1) - C3 - C_(-2,+2) )*cM
        eM9 = ( 5._wp*C_(+1,-1) - C_(-1,+1) - C3 - C_(+2,-2) )*cM
        DcDx = c23*eC2 + c16*( eC6 - eC7 )
        DcDy = c23*eC3 + c16*( eC6 + eC7 )
        DmDx = c13*( eM2 - eM4 ) + c112*( (eM6 - eM8) - (eM7 - eM9) )
        DmDy = c13*( eM3 - eM5 ) + c112*( (eM6 - eM8) + (eM7 - eM9) )
        g2 = DcDx*DcDx + DcDy*DcDy
        rn = MERGE( 1._wp, 0._wp, g2 > grad2_min ) / SQRT( MAX( g2, grad2_min ) )
        ni = DcDx*rn
        nj = DcDy*rn
