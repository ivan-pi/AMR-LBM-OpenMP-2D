!================================================
!   Mass-conserving phase-field LBM (JCP 2016)
!
!   A. Fakhari, M. Geier, T. Lee, "A mass-conserving lattice Boltzmann
!   method with dynamic grid refinement for immiscible two-phase flows",
!   J. Comput. Phys. 315 (2016) 434-457
!
!   Conservative Allen-Cahn equation for C (h) with the interface
!   sharpening built into the equilibrium; pressure-evolution equation (g)
!   whose forcing uses central and mixed directional differences of C
!   (two ghost layers of C); reduced MRT collision of g.
!
!   The form of the collision kernel is the outcome of the measurements in
!   docs/benchmarks/2026-11-26-kernel-performance.md.
!================================================
MODULE Model_JCP2016_Mod
    USE Kinds_Mod, ONLY: wp
    USE Config_Mod, ONLY: nx, ny, inv_dx_level     ! the fixed block size, 1/dx per level
    USE D2Q9_Mod, ONLY: Wa, ex, ey, exr, eyr, w0, ws, wd
    USE Physics_Mod, ONLY: W, M0, wc, Gy, taul, tauh, Rhol, Rhoh, Beta, kappa
    USE Model_Mod, ONLY: LBM_Model
    USE Phase_Field_Mod, ONLY: Chemical_Potential_AMR, Gradient_AMR, Interface_Error, grad2_min
    IMPLICIT NONE
    PRIVATE
    PUBLIC :: JCP2016_Model

    REAL(wp), PARAMETER :: c13 = 1._wp/3._wp, c112 = 1._wp/12._wp, c23 = 2._wp/3._wp, c16 = 1._wp/6._wp

CONTAINS

FUNCTION JCP2016_Model() RESULT( model )
    TYPE(LBM_Model) :: model

    model%name       =  'mass-conserving phase-field LBM (Fakhari, Geier & Lee, JCP 2016)'
    model%ghost_C    =  2       ! mixed differences reach two cells
    model%Initialize => Initialize_Block
    model%Collide    => Collide_Block
    model%Moments_g  => Moments_g_Block
    model%Moments_and_Collide => Moments_and_Collide_Block
    model%Refinement_Error    => Interface_Error

END FUNCTION JCP2016_Model

!**********************************************************************

SUBROUTINE Collide_Block( n )
    USE Blocks_Mod, ONLY: Blk, Blk_h, Blk_g, Blk_C, Blk_P, Blk_Ux, Blk_Uy
    INTEGER, INTENT(IN) :: n

    CALL Collision_h_g_AMR( inv_dx_level( Blk(n)%Level ), Blk_C(:,:,n), Blk_P(:,:,n), &
                            Blk_Ux(:,:,n), Blk_Uy(:,:,n), Blk_h(:,:,:,n), Blk_g(:,:,:,n) )

END SUBROUTINE Collide_Block

!**********************************************************************

SUBROUTINE Moments_g_Block( n )
    USE Blocks_Mod, ONLY: Blk, Blk_g, Blk_C, Blk_P, Blk_Ux, Blk_Uy
    INTEGER, INTENT(IN) :: n

    REAL(wp) :: mu(nx,ny), inv_dx

    inv_dx = inv_dx_level( Blk(n)%Level )
    CALL Chemical_Potential_AMR( inv_dx, Blk_C(:,:,n), mu )
    CALL Macroscopic_Values_g_AMR( inv_dx, Blk_g(:,:,:,n), Blk_C(:,:,n), mu, &
                                   Blk_P(:,:,n), Blk_Ux(:,:,n), Blk_Uy(:,:,n) )

END SUBROUTINE Moments_g_Block

!**********************************************************************

!== moments of g and collision of one block in one pass over its cells
SUBROUTINE Moments_and_Collide_Block( n )
    USE Blocks_Mod, ONLY: Blk, Blk_h, Blk_g, Blk_C, Blk_P, Blk_Ux, Blk_Uy
    INTEGER, INTENT(IN) :: n

    CALL Moments_Collision_h_g_AMR( inv_dx_level( Blk(n)%Level ), Blk_C(:,:,n), Blk_P(:,:,n), &
                                    Blk_Ux(:,:,n), Blk_Uy(:,:,n), Blk_h(:,:,:,n), Blk_g(:,:,:,n) )

END SUBROUTINE Moments_and_Collide_Block

!**********************************************************************

!== equilibrium h and g of block n from C, P, Ux, Uy (no body force);
!   runs once per block at the start, so it is written for clarity
SUBROUTINE Initialize_Block( n )
    USE Blocks_Mod, ONLY: Blk, Blk_h, Blk_g, Blk_C, Blk_P, Blk_Ux, Blk_Uy
    INTEGER, INTENT(IN) :: n

    INTEGER :: i, j, k
    REAL(wp) :: inv_dx, Rho, dRho3, cT, ni, nj, DcDx, DcDy, g2, rn, U, V
    REAL(wp) :: eDc(9), hlp(9), Gamma(9), eU(9), eN(9), mu(nx,ny)

    inv_dx = inv_dx_level( Blk(n)%Level )
    dRho3  = (Rhoh - Rhol)*c13
    cT     = 12._wp*M0/W

    CALL Chemical_Potential_AMR( inv_dx, Blk_C(:,:,n), mu )

    DO j = 1, ny
    DO i = 1, nx
        !== central differences along e_k and the isotropic gradient
        DO k = 1, 9
            eDc(k) = ( Blk_C(i+ex(k),j+ey(k), n) - Blk_C(i-ex(k),j-ey(k), n) )*(0.5_wp*inv_dx)
        END DO
        DcDx = c13*( eDc(2)-eDc(4) ) + c112*( eDc(6)-eDc(7)-eDc(8)+eDc(9) )
        DcDy = c13*( eDc(3)-eDc(5) ) + c112*( eDc(6)+eDc(7)-eDc(8)-eDc(9) )

        !== unit normal (zero away from the interface)
        g2 = DcDx*DcDx + DcDy*DcDy
        rn = MERGE( 1._wp, 0._wp, g2 > grad2_min ) / SQRT( MAX( g2, grad2_min ) )
        ni = DcDx*rn
        nj = DcDy*rn

        U   = Blk_Ux(i,j, n)
        V   = Blk_Uy(i,j, n)
        Rho = Rhol + Blk_C(i,j, n) * (Rhoh - Rhol)

        eU(:) = exr(:)*U  + eyr(:)*V
        eN(:) = exr(:)*ni + eyr(:)*nj
        Gamma(:) = Wa(:) * ( 1._wp + eU(:)*(3._wp + 4.5_wp*eU(:)) - 1.5_wp*(U*U + V*V) )

        Blk_h(i,j,:, n) = Blk_C(i,j, n) * ( Gamma(:) + cT*(1._wp - Blk_C(i,j, n)) * Wa(:) * eN(:) )

        hlp(:) = ( (Gamma(:)-Wa(:))*dRho3 + Gamma(:)*mu(i,j) ) * ( eDc(:) - (U*DcDx + V*DcDy) )
        Blk_g(i,j,:, n) = Blk_P(i,j, n)*Wa(:) + (Gamma(:)-Wa(:))*(Rho*c13) - 0.5_wp*hlp(:)
    END DO
    END DO

END SUBROUTINE Initialize_Block

!**********************************************************************

!== Collision of h and g for one block, cell by cell in a single pass,
!   generated (Fypp) in two forms:
!
!     Collision_h_g_AMR            P, Ux, Uy are input
!     Moments_Collision_h_g_AMR    P, Ux, Uy are computed first from g (zeroth
!                                  and first moments, with the forces) and stored
!
!   One routine with the choice inside the cell loop is not vectorized by
!   gfortran (three times slower), hence the two instances.
!
!   Everything a cell needs is computed in the one loop body, the chemical
!   potential and the moments included: the differences of C are shared, no
!   work array is passed between loops, and h, g are loaded once (+30-65 %
!   over three separate passes; docs/benchmarks/2026-11-26-kernel-performance.md).
!
!   h relaxes to its equilibrium with rate wc (BGK). g is collided with the
!   MRT operator of the paper and gets the forcing. The loop body does not
!   follow the formulas of the paper term by term; it uses four symmetries:
!
!   1. Opposite directions. The eight moving directions are four pairs of
!      opposite directions: (2,4) along x, (3,5) along y, (6,8) and (7,9)
!      along the diagonals. The equilibrium weight Gamma of the two members
!      of a pair is a common part Gs (even in the velocity) plus or minus a
!      part Ga (odd in the velocity):
!
!          Gamma(k) = Gs + Ga        Gamma(opposite of k) = Gs - Ga
!
!      so a pair needs Gs and Ga once (Gp, Gm in the code).
!
!   2. Only two moments keep a memory. The MRT operator sets every moment of
!      g to its equilibrium (rate 1) except the two stress moments
!
!          m8 = (g2 + g4) - (g3 + g5)        normal stress difference
!          m9 = (g6 + g8) - (g7 + g9)        shear stress
!
!      which relax with the rate s9 of the viscosity. After the collision a
!      direction therefore is: equilibrium, plus forcing, plus or minus
!      (1 - s9)/4 times the non-equilibrium part of m8 (+ for 2 and 4, - for
!      3 and 5) or of m9 (+ for 6 and 8, - for 7 and 9).
!
!   3. The stress moments only see pair sums. m8 and m9 contain each pair as
!      the sum of its two members. In the sum of the two equilibria of a pair
!      every odd term cancels, and in the difference of the two pairs of a
!      moment the pressure term and the constant part of Gs cancel as well.
!      What is left is a short expression in the velocity, the gradient of C
!      and the buoyancy (the two statements for m8 and m9 below). The
!      equilibrium of a single direction, and g minus it, are never formed.
!
!   4. One difference of C per direction. The forcing of the paper uses a
!      central and a mixed difference of C along every direction. Per
!      direction they only occur as mixed minus half the central one, which
!      is the one-sided difference
!
!          B(k) = ( 4 C(x + e_k) - 3 C(x) - C(x + 2 e_k) ) / (4 dx)
!
!   Together: about a quarter fewer operations than relaxing every direction
!   against its own equilibrium, and every g is stored as soon as it is
!   computed. The results differ from that form by round-off only (1e-14).
#:for NAME, MOMENTS in [ ( 'Collision_h_g_AMR', False ), ( 'Moments_Collision_h_g_AMR', True ) ]
SUBROUTINE ${NAME}$( inv_dx, C, P, Ux, Uy, h, g )
    IMPLICIT NONE
    REAL(wp), INTENT(IN)    :: inv_dx      ! 1/dx in finest-level lattice units
    REAL(wp), INTENT(IN)    :: C(-1:nx+2,-1:ny+2)
#:if MOMENTS
    REAL(wp), INTENT(OUT)   :: P (nx,ny), Ux(nx,ny), Uy(nx,ny)
#:else
    REAL(wp), INTENT(IN)    :: P (nx,ny), Ux(nx,ny), Uy(nx,ny)
#:endif
    REAL(wp), INTENT(INOUT) :: h(0:nx+1,0:ny+1,9), g(0:nx+1,0:ny+1,9)

    INTEGER :: i, j
    !== per block
    REAL(wp) :: cC, cM, dRho, dRho3, dRho6, invTaul, dInvTau, tws, twd, omwc, w0d, wsd, wdd
    REAL(wp) :: c4B, cK, hGy, ws3, wd3, ws45, wd18, wd12
    !== per cell
    REAL(wp) :: C0, C3, eC2, eC3, eC6, eC7, B2, B3, B4, B5, B6, B7, B8, B9, t68, t79
    REAL(wp) :: DcDx, DcDy, DmDx, DmDy, g2, rn, ni, nj, xmu, vx, vy, vxx, vyy, base0, uDc, D0
    REAL(wp) :: Rho, rho3, hF, Pc, Pr, amu, cH, tCH, t, km, m8, m9, r0, rp, rm, Q
    REAL(wp) :: v, Gs, Ga, Gp, Gm, sq, Pw
    REAL(wp) :: S0, Sx, Sy, rRho

    cC      = 0.5_wp *inv_dx               ! central difference (C(x+e)-C(x-e))/(2 dx)
    cM      = 0.25_wp*inv_dx               ! biased difference over 4 dx
    dRho    = Rhoh - Rhol
    dRho3   = dRho*c13
    dRho6   = dRho*c16
    invTaul = 1._wp/taul                    ! 1/tau is linear in C between
    dInvTau = 1._wp/tauh - invTaul          ! the light (C=0) and heavy (C=1) fluid
    tws     = 12._wp*M0/W * ws              ! sharpening: 12 M0 (1-C)/W, times the weight
    twd     = 12._wp*M0/W * wd
    omwc    = 1._wp - wc
    w0d     = w0*dRho3
    wsd     = ws*dRho3
    wdd     = wd*dRho3
    c4B     = 4._wp*Beta                    ! chemical potential: bulk part and
    cK      = kappa*inv_dx*inv_dx/6._wp     ! kappa/dx**2 with the 1/6 of the Laplacian
    hGy     = 0.5_wp*Gy
    ws3     = 3._wp*ws
    wd3     = 3._wp*wd
    ws45    = 4.5_wp*ws
    wd18    = 18._wp*wd
    wd12    = 12._wp*wd

    DO j = 1, ny
    DO i = 1, nx
        C0 = C(i,j)

        !== central differences along e2 = (1,0), e3 = (0,1), e6 = (1,1),
        !   e7 = (-1,1); the opposite directions have the negative values
        eC2 = ( C(i+1,j  ) - C(i-1,j  ) )*cC
        eC3 = ( C(i  ,j+1) - C(i  ,j-1) )*cC
        eC6 = ( C(i+1,j+1) - C(i-1,j-1) )*cC
        eC7 = ( C(i-1,j+1) - C(i+1,j-1) )*cC

        !== biased differences B_k = ( 4 C(x+e_k) - 3 C(x) - C(x+2e_k) )/(4 dx): the
        !   mixed difference eM_k = ( 5 C(x+e) - C(x-e) - 3 C(x) - C(x+2e) )/(4 dx)
        !   minus half the central one
        C3 = 3._wp*C0
        B2 = ( 4._wp*C(i+1,j  ) - C3 - C(i+2,j  ) )*cM
        B4 = ( 4._wp*C(i-1,j  ) - C3 - C(i-2,j  ) )*cM
        B3 = ( 4._wp*C(i  ,j+1) - C3 - C(i  ,j+2) )*cM
        B5 = ( 4._wp*C(i  ,j-1) - C3 - C(i  ,j-2) )*cM
        B6 = ( 4._wp*C(i+1,j+1) - C3 - C(i+2,j+2) )*cM
        B8 = ( 4._wp*C(i-1,j-1) - C3 - C(i-2,j-2) )*cM
        B7 = ( 4._wp*C(i-1,j+1) - C3 - C(i-2,j+2) )*cM
        B9 = ( 4._wp*C(i+1,j-1) - C3 - C(i+2,j-2) )*cM

        !== isotropic gradients: sum_k w_k e_k (differences along e_k)/cs^2;
        !   for the mixed differences eM_k - eM_k' = (B_k - B_k') + eC_k
        DcDx = c23*eC2 + c16*( eC6 - eC7 )
        DcDy = c23*eC3 + c16*( eC6 + eC7 )
        t68  = ( B6 - B8 ) + eC6
        t79  = ( B7 - B9 ) + eC7
        DmDx = c13*( ( B2 - B4 ) + eC2 ) + c112*( t68 - t79 )
        DmDy = c13*( ( B3 - B5 ) + eC3 ) + c112*( t68 + t79 )

        !== unit normal; zero away from the interface (|grad C|**2 <= grad2_min),
        !   branch-free (a mask over a clamped root) so that the loop vectorizes
        g2 = DcDx*DcDx + DcDy*DcDy
        rn = MERGE( 1._wp, 0._wp, g2 > grad2_min ) / SQRT( MAX( g2, grad2_min ) )
        ni = DcDx*rn
        nj = DcDy*rn

        !== chemical potential mu = 4 beta C (C-1) (C-1/2) - kappa Laplacian(C),
        !   isotropic 9-point Laplacian (as Chemical_Potential_AMR)
        xmu = c4B*C0*(C0-1._wp)*(C0-0.5_wp) - cK*( ( C(i-1,j-1) + C(i+1,j-1) + C(i-1,j+1) + C(i+1,j+1) ) &
            + 4._wp*( C(i,j-1) + C(i-1,j) + C(i+1,j) + C(i,j+1) ) - 20._wp*C0 )

        Rho = Rhol + C0*dRho
#:if MOMENTS
        !== pressure and velocity from g and the forces (as Macroscopic_Values_g_AMR):
        !   u = ( sum(g e)/cs^2 + F/2 )/rho
        S0 = g(i,j,1) + ( (g(i,j,2) + g(i,j,3)) + (g(i,j,4) + g(i,j,5)) ) &
                      + ( (g(i,j,6) + g(i,j,7)) + (g(i,j,8) + g(i,j,9)) )
        Sx = ( g(i,j,2) - g(i,j,4) ) + ( (g(i,j,6) - g(i,j,7)) + (g(i,j,9) - g(i,j,8)) )
        Sy = ( g(i,j,3) - g(i,j,5) ) + ( (g(i,j,6) + g(i,j,7)) - (g(i,j,8) + g(i,j,9)) )
        rRho = 1._wp/Rho
        vx = ( 3._wp*Sx + 0.5_wp*( xmu*DcDx ) )*rRho
        vy = ( 3._wp*Sy + 0.5_wp*( xmu*DcDy + (Rhoh - Rho)*Gy ) )*rRho
        Pc = S0 + dRho6*( vx*DcDx + vy*DcDy )
        Ux(i,j) = vx
        Uy(i,j) = vy
        P (i,j) = Pc
#:else
        !== pressure and velocity from the existing fields
        vx = Ux(i,j)
        vy = Uy(i,j)
        Pc = P(i,j)
#:endif

        !== per-cell quantities
        vxx   = vx*vx
        vyy   = vy*vy
        base0 = 1._wp - 1.5_wp*( vxx + vyy )
        uDc   = vx*DcDx + vy*DcDy
        D0    = 0.5_wp*uDc - ( vx*DmDx + vy*DmDy )
        rho3  = Rho*c13
        hF    = (Rhoh - Rho)*hGy                ! half the buoyancy
        amu   = dRho3 + xmu                     ! A_k = Gamma_k amu - w_k dRho3
        Pr    = Pc - rho3
        r0    = rho3 - hF*vy                    ! r for ey = 0, +1, -1
        rp    = r0 + hF
        rm    = r0 - hF
        cH    = wc*C0                           ! h relaxes towards C (Gamma + sharpening)
        tCH   = 1._wp - C0

        !== (1 - s9)/4 for the relaxation rate s9 = 1/tau with tau = 1/t + 1/2, where
        !   t = 1/tau_fluid is interpolated in C (C clamped, as it may overshoot
        !   [0,1] at the interface): 1 - s9 = (2 - t)/(2 + t)
        t  = MIN( MAX( C0, 0._wp ), 1._wp ) * dInvTau + invTaul
        km = 0.25_wp*( 2._wp - t )/( 2._wp + t )

        !== stress moments of g - geq, relaxed. Sums of geq over a pair:
        !     geq+ + geq- = 2 Pw + Gamma+ q+ + Gamma- q- - Aa eC + As u.grad C,
        !   q+- = rho/3 - (+-ey - vy) Fb/2, As = Gs amu - w dRho3, Aa = Ga amu
        Q  = 2._wp*( rho3 + hF*vy ) + amu*uDc
        m8 = km*( ( (g(i,j,2) + g(i,j,4)) - (g(i,j,3) + g(i,j,5)) ) &
                - ( ws45*(vxx - vyy)*Q + ws3*( 2._wp*vy*hF - amu*( vx*eC2 - vy*eC3 ) ) ) )
        m9 = km*( ( (g(i,j,6) + g(i,j,8)) - (g(i,j,7) + g(i,j,9)) ) &
                - ( wd18*vx*vy*Q - wd12*hF*vx - wd3*amu*( (vx + vy)*eC6 - (vy - vx)*eC7 ) ) )

        !== rest direction (e = 0): no stress moments
        Gp = w0*base0
        h(i,j,1) = omwc*h(i,j,1) + cH*Gp
        g(i,j,1) = Pr*w0 + Gp*r0 + ( Gp*amu - w0d )*D0

        !== pair (2,4): e = (+-1, 0)
        Gs = ws*( base0 + 4.5_wp*vxx )
        Ga = ws3*vx
        Gp = Gs + Ga
        Gm = Gs - Ga
        sq = tCH*tws*ni
        h(i,j,2) = omwc*h(i,j,2) + cH*( Gp + sq )
        h(i,j,4) = omwc*h(i,j,4) + cH*( Gm - sq )
        Pw = Pr*ws + m8
        g(i,j,2) = Pw + Gp*r0 + ( Gp*amu - wsd )*( B2 + D0 )
        g(i,j,4) = Pw + Gm*r0 + ( Gm*amu - wsd )*( B4 + D0 )

        !== pair (3,5): e = (0, +-1)
        Gs = ws*( base0 + 4.5_wp*vyy )
        Ga = ws3*vy
        Gp = Gs + Ga
        Gm = Gs - Ga
        sq = tCH*tws*nj
        h(i,j,3) = omwc*h(i,j,3) + cH*( Gp + sq )
        h(i,j,5) = omwc*h(i,j,5) + cH*( Gm - sq )
        Pw = Pr*ws - m8
        g(i,j,3) = Pw + Gp*rp + ( Gp*amu - wsd )*( B3 + D0 )
        g(i,j,5) = Pw + Gm*rm + ( Gm*amu - wsd )*( B5 + D0 )

        !== pair (6,8): e = +-(1, 1)
        v  = vx + vy
        Gs = wd*( base0 + 4.5_wp*v*v )
        Ga = wd3*v
        Gp = Gs + Ga
        Gm = Gs - Ga
        sq = tCH*twd*( ni + nj )
        h(i,j,6) = omwc*h(i,j,6) + cH*( Gp + sq )
        h(i,j,8) = omwc*h(i,j,8) + cH*( Gm - sq )
        Pw = Pr*wd + m9
        g(i,j,6) = Pw + Gp*rp + ( Gp*amu - wdd )*( B6 + D0 )
        g(i,j,8) = Pw + Gm*rm + ( Gm*amu - wdd )*( B8 + D0 )

        !== pair (7,9): e = +-(-1, 1)
        v  = vy - vx
        Gs = wd*( base0 + 4.5_wp*v*v )
        Ga = wd3*v
        Gp = Gs + Ga
        Gm = Gs - Ga
        sq = tCH*twd*( nj - ni )
        h(i,j,7) = omwc*h(i,j,7) + cH*( Gp + sq )
        h(i,j,9) = omwc*h(i,j,9) + cH*( Gm - sq )
        Pw = Pr*wd - m9
        g(i,j,7) = Pw + Gp*rp + ( Gp*amu - wdd )*( B7 + D0 )
        g(i,j,9) = Pw + Gm*rm + ( Gm*amu - wdd )*( B9 + D0 )
    END DO
    END DO

END SUBROUTINE ${NAME}$

!**********************************************************************

#:endfor

!**********************************************************************

SUBROUTINE Macroscopic_Values_g_AMR( inv_dx, g, C, mu, P, Ux, Uy )
    !== pressure and velocity from g (zeroth and first moments) and the forces
    IMPLICIT NONE
    REAL(wp), INTENT(IN)  :: inv_dx         ! 1/dx in finest-level lattice units
    REAL(wp), INTENT(IN)  :: g(0:nx+1,0:ny+1,9), C(-1:nx+2,-1:ny+2), mu(nx,ny)
    REAL(wp), INTENT(OUT) :: P (nx,ny), Ux(nx,ny), Uy(nx,ny)

    INTEGER :: i, j
    REAL(wp) :: dRho, dRho6, S0, Sx, Sy, Rho, rRho, Fx, Fy
    REAL(wp) :: DcDx(nx,ny), DcDy(nx,ny)

    dRho  = Rhoh - Rhol
    dRho6 = dRho*c16

    CALL Gradient_AMR( inv_dx, C, DcDx, DcDy )

    DO j = 1, ny
    DO i = 1, nx
        S0 = g(i,j,1) + ( (g(i,j,2) + g(i,j,3)) + (g(i,j,4) + g(i,j,5)) ) &
                      + ( (g(i,j,6) + g(i,j,7)) + (g(i,j,8) + g(i,j,9)) )
        Sx = ( g(i,j,2) - g(i,j,4) ) + ( (g(i,j,6) - g(i,j,7)) + (g(i,j,9) - g(i,j,8)) )
        Sy = ( g(i,j,3) - g(i,j,5) ) + ( (g(i,j,6) + g(i,j,7)) - (g(i,j,8) + g(i,j,9)) )

        Rho  = Rhol + C(i,j)*dRho
        rRho = 1._wp/Rho

        Fx = mu(i,j)*DcDx(i,j)
        Fy = mu(i,j)*DcDy(i,j) + (Rhoh - Rho)*Gy

        !== u = ( sum(g e)/cs^2 + F/2 )/rho, from rho u = sum(f e) + F/2 and
        !   sum(g e) = cs^2 sum(f e). (Eq. (35) of the paper prints the force term
        !   without the factor cs^2; this form is consistent with its Eq. (24).)
        Ux(i,j) = ( 3._wp*Sx + 0.5_wp*Fx )*rRho
        Uy(i,j) = ( 3._wp*Sy + 0.5_wp*Fy )*rRho

        P (i,j) = S0 + dRho6*( Ux(i,j)*DcDx(i,j) + Uy(i,j)*DcDy(i,j) )
    END DO
    END DO

END SUBROUTINE Macroscopic_Values_g_AMR

END MODULE Model_JCP2016_Mod
