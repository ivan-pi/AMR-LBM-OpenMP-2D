#!================================================
#!   Fypp macros: biquadratic interpolation of a strip of nk components (stored
#!   last) from a fine to a coarse level (BIQUADRATIC_FROM_FINE) and from a
#!   coarse to a fine level (BIQUADRATIC_FROM_COARSE).
#!
#!     name    name of the generated subroutine
#!     shape   the strip shape as named constants, e.g.
#!             'i2 = 3, j2 = 2*ny, x2 = 1, y2 = ny, nk = 8':
#!             input i2 x j2 values per component, output x2 x y2
#!
#!   The shape is fixed at compile time, which lets the compiler unroll the
#!   short loops. Used by Ghost_hg_Mod and Ghost_C_Mod:
#!
#!     #:include "Biquadratic.fypp"
#!     $:BIQUADRATIC_FROM_FINE( 'From_Fine_LR', 'i2 = 3, j2 = 2*ny, x2 = 1, y2 = ny, nk = 8' )
#!================================================
#:def BIQUADRATIC_FROM_FINE( name, shape )
SUBROUTINE ${name}$( fin_F, fout_C )
    IMPLICIT NONE
    INTEGER, PARAMETER :: ${shape}$
    REAL(wp), INTENT(IN ) :: fin_F (i2,j2,nk)
    REAL(wp), INTENT(OUT) :: fout_C(x2,y2,nk)

    INTEGER :: X, J, i, a, b, c
    REAL(wp) :: tmp(i2,y2,nk), wa, wb, wc

    !== weights (a, b, c)/8 per direction; the second pass carries both
    !   factors 1/8 (1/64 is a power of two, so this equals dividing at the end)
    b = 6
    DO X = 1, y2
        J = MOD(X+1,2)
        i = 2*X-1 - J
        a = 3 - 4*J
        c = 2 - a

        tmp(:,X,:) = a * fin_F(:,i,:) + b * fin_F(:,i+1,:) + c * fin_F(:,i+2,:)

    END DO
    wb = b / 64._wp
    DO X = 1, x2
        J = MOD(X+1,2)
        i = 2*X-1 - J
        a = 3 - 4*J
        c = 2 - a
        wa = a / 64._wp
        wc = c / 64._wp

        fout_C(X,:,:) = wa * tmp(i,:,:) + wb * tmp(i+1,:,:) + wc * tmp(i+2,:,:)

    END DO

END SUBROUTINE ${name}$
#:enddef BIQUADRATIC_FROM_FINE

#:def BIQUADRATIC_FROM_COARSE( name, shape )
SUBROUTINE ${name}$( fin_C, fout_F )
    IMPLICIT NONE
    INTEGER, PARAMETER :: ${shape}$
    REAL(wp), INTENT(IN ) :: fin_C (i2,j2,nk)
    REAL(wp), INTENT(OUT) :: fout_F(x2,y2,nk)

    INTEGER :: x, I, a, b, c
    REAL(wp) :: tmp(i2,y2,nk), wa, wb, wc

    !== weights (a, b, c)/32 per direction; the second pass carries both
    !   factors 1/32 (1/1024 is a power of two, so this equals dividing at the end)
    b = 30
    DO x = 1, y2
        I = (x+1)/2
        a = 5 - 8*MOD(x+1,2)
        c = 2-a

        tmp(:,x,:) = a * fin_C(:,I,:) + b * fin_C(:,I+1,:) + c * fin_C(:,I+2,:)

    END DO
    wb = b / 1024._wp
    DO x = 1, x2
        I = (x+1)/2
        a = 5 - 8*MOD(x+1,2)
        c = 2-a
        wa = a / 1024._wp
        wc = c / 1024._wp

        fout_F(x,:,:) = wa * tmp(I,:,:) + wb * tmp(I+1,:,:) + wc * tmp(I+2,:,:)

    END DO

END SUBROUTINE ${name}$
#:enddef BIQUADRATIC_FROM_COARSE
